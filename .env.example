# 复制为 .env.local / .env.development.local 后按需覆盖（不要提交真实 token）
#
# API 基础地址：
#   /api                          → dev 走 Vite 代理（默认）、生产走 nginx（docker compose 默认）
#   http://localhost:23020        → 绕过代理直连本机 xyz 后端（后端 CORS 已放开）
VITE_API_BASE_URL=/api

# 离线 Mock（不依赖后端即可看界面）：VITE_API_MOCK=1 pnpm dev
VITE_API_MOCK=0

# dev 代理目标（仅 vite.config.ts 读取，默认 http://localhost:23020）
# XYZ_API_TARGET=http://localhost:23020
